# Identity worker (OIDC issuer) and api worker origins; local defaults of `pnpm dev` in each service.
VITE_ISSUER=http://localhost:8787
VITE_API_ORIGIN=http://localhost:8788
# Name shown in the console header and page title.
VITE_PLATFORM_NAME=z-cloudbase
# Optional branding (PRD §21.4; set by `pnpm platform:deploy --logo-url / --primary-color`): an https logo URL
# and a #rgb / #rrggbb primary color. Invalid values are ignored.
# VITE_BRAND_LOGO_URL=https://example.com/logo.svg
# VITE_BRAND_PRIMARY_COLOR=#4f46e5
