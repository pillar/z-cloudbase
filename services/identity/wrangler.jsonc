// Identity domain: OIDC issuer, login / link UI, sessions (PRD §19.2).
// database_id values are local placeholders; `pnpm platform:deploy` generates the real ones (scripts/deploy.ts).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "z-cloudbase-identity",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ISSUER": "http://localhost:8787",
    "DEPLOY_ENV": "local",
    // Display name on the sign-in pages, in mail and as the TOTP issuer (set by `pnpm platform:deploy --name`).
    "PLATFORM_NAME": "z-cloudbase",
    // "true": console sign-in requires TOTP enrollment; otherwise admins may enable it themselves.
    "REQUIRE_ADMIN_2FA": "false",
    // Turnstile widget site key (PRD §19.11). This is Cloudflare's public TESTING key ("always passes",
    // tokens are the dummy XXXX.DUMMY.TOKEN.XXXX); a deployment sets its real site key here and the
    // TURNSTILE_SECRET_KEY secret (siteverify). With DEPLOY_ENV=local no secret is used (src/turnstile.ts).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Registration (PRD §21.2): SIGNUP_MODE open | invite | closed. REQUIRE_EMAIL_VERIFICATION defaults to
    // "true" in deployments; local development turns it off so sign-up can be followed by sign-in without
    // opening the outbox (tests of the verified flow override it with useEnv).
    "SIGNUP_MODE": "open",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    // Language of the identity pages and mail without ?lang / cookie / Accept-Language (PRD §21.4).
    "DEFAULT_LANG": "en"
    // Further optional vars of a deployment (scripts/platform-deploy.ts): EMAIL_TRANSPORT (resend | smtp |
    // cloudflare), EMAIL_FROM, SMTP_HOST, SMTP_PORT, SMTP_USERNAME, PASSKEYS, MAGIC_LINK, BRAND_LOGO_URL,
    // BRAND_PRIMARY_COLOR, SIGNIN_TAGLINE. EMAIL_TRANSPORT=cloudflare adds a `send_email` binding SEND_EMAIL.
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "z-cloudbase-platform", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "../../database/migrations" }
  ],
  // Private archive: completed data exports (exports/{user_id}/...) are downloaded from here (PRD §19.8).
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "z-cloudbase-archive" }
  ],
  // AUTH_SECRET: Better Auth secret (>= 32 chars). Local dev reads it from .dev.vars (not committed).
  // SETUP_TOKEN: operator setup (src/setup.ts); without it the /setup routes do not exist, so local dev
  // only warns when it is missing. Listing it here is what makes `wrangler dev` load it (a `secrets`
  // block limits local secrets to the listed names). Deployments get both from scripts/platform-deploy.ts.
  // Further optional secrets of a deployment: RESEND_API_KEY or SMTP_PASSWORD, TURNSTILE_SECRET_KEY, Google / Apple.
  "secrets": { "required": ["AUTH_SECRET", "SETUP_TOKEN"] },
  "dev": { "port": 8787 }
}
