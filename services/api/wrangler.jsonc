// Platform API: /v1/* me, storage, logs, events, admin (PRD §19.2).
// database_id / bucket / queue names are local placeholders; `pnpm platform:deploy` generates the real ones (scripts/deploy.ts).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudbase-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ISSUER": "http://localhost:8787",
    "API_ORIGIN": "http://localhost:8788",
    "DEPLOY_ENV": "local",
    // Analytics Engine dataset the consumer writes (its EVENTS_AE binding); read via the AE SQL API.
    "AE_DATASET": "cloudbase_events"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cloudbase-platform", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "../../database/migrations" },
    { "binding": "INGEST_DB", "database_name": "cloudbase-ingest", "database_id": "00000000-0000-4000-8000-000000000002", "migrations_dir": "../../database/ingest-migrations" }
  ],
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "cloudbase-storage" },
    { "binding": "ARCHIVE", "bucket_name": "cloudbase-archive" }
  ],
  "queues": {
    "producers": [
      { "binding": "LOGS_QUEUE", "queue": "cloudbase-logs" },
      { "binding": "EVENTS_QUEUE", "queue": "cloudbase-events" }
    ]
  },
  "services": [{ "binding": "IDENTITY", "service": "cloudbase-identity", "entrypoint": "IdentityRpc" }],
  "ratelimits": [
    { "name": "INGEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 600, "period": 60 } }
  ],
  "dev": { "port": 8788 }
}
